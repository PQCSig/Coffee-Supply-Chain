# Wallet mnemonic — never commit
.secret

# Environment files — real credentials live in the environment, never in the repo.
# .env.example (placeholders only) is the committed exception.
.env
.env.*
!.env.example

# Node
node_modules/

# Truffle build artifacts (generated by `truffle compile`)
build/contracts/

# Security workflow artifacts (see security/_template_redteam_workflow.md — "What never gets committed")
# Audit/triage snapshots and enrichment caches leak the production vulnerability map.
# The accepted-risk LEDGER is committed policy, not a snapshot — never ignore it.
security/.cache/
security/*audit*.json
npm-audit*.json
!.npm-audit-exceptions.json
.cache/

# Engagement evidence: only redacted markdown findings are committed,
# any payloads/captures dropped into engagements/ stay out of history
security/engagements/**
!security/engagements/*.md

# Insights: durable cross-engagement lessons — markdown commits like findings,
# anything else dropped there stays local. The directory itself must be
# re-included before files inside it can be (git cannot re-include a file
# whose parent directory is excluded).
security/engagements/insights/**
!security/engagements/insights/
!security/engagements/insights/*.md

# Agent skill library — maintainer-local reference material, not project
# source. AGENTS.md skill links resolve only in clones that hold the library.
.agent/skills/
.agent/skills/
