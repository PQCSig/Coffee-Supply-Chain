{
  "name": "supply-chain-E",
  "version": "2.0.0",
  "description": "Fair Trade Coffee supply chain DApp (Ethereum smart contracts + lite-server DApp UI)",
  "main": "index.html",
  "scripts": {
    "dev": "lite-server",
    "build": "truffle compile",
    "compile": "truffle compile",
    "test": "truffle test",
    "lint": "solhint 'contracts/**/*.sol'",
    "audit": "npm audit --omit=dev",
    "security:check": "node scripts/audit-with-exceptions.mjs --audit-level=high",
    "outdated": "npm outdated"
  },
  "keywords": [
    "ethereum",
    "supply-chain",
    "solidity",
    "dapp"
  ],
  "author": "pk <pkrasam@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@truffle/hdwallet-provider": "^2.1.15",
    "lite-server": "^2.6.1",
    "solhint": "^3.6.2",
    "truffle": "^5.11.5",
    "truffle-assertions": "^0.9.2"
  },
  "dependencies": {
    "web3": "^4.16.0"
  }
}
